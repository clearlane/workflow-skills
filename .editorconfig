# Editor defaults for this repository, so whitespace never becomes a diff.
#
# Skill guidance stays runtime-neutral; this file configures contributors'
# editors and ships nothing to a host that loads SKILL.md.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown is the product here. Trailing whitespace is a hard line break in
# CommonMark, so trimming it would silently rewrite rendered output.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
