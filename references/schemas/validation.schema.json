{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearlane.github.io/workflow-skills/schemas/validation.schema.json",
  "title": "Absorption validation evidence",
  "description": "validation.json. The evidence that decides whether the run completes or returns to merge, so a claim of success has to carry the checks that support it.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "plan_sha256",
    "passed",
    "checks",
    "remaining_gaps",
    "notes"
  ],
  "properties": {
    "schema": {
      "$ref": "common.schema.json#/$defs/schemaRef"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "plan_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "description": "What was actually run. An empty list would let a verdict rest on nothing at all.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "remaining_gaps": {
      "$ref": "common.schema.json#/$defs/textList"
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/textList"
    }
  },
  "allOf": [
    {
      "description": "A pass cannot coexist with a failing check or an open gap. Stated here so the contradiction is rejected by the schema rather than only by the coordinator.",
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "exit_code": {
                  "const": 0
                }
              }
            }
          },
          "remaining_gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "name",
        "command",
        "exit_code"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "command": {
          "description": "The exact command, so the result can be reproduced rather than taken on trust.",
          "$ref": "common.schema.json#/$defs/text"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    }
  },
  "additionalProperties": false
}
