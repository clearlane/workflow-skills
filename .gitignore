.DS_Store
.agents/
.codegraph/
__pycache__/
*.html

# Artifacts of the toolchain pyproject.toml declares. A `pip install .` or a
# `ruff` run must not leave anything a later `git add -A` would commit, so
# every tool named there gets an entry here.
*.egg-info/
build/
dist/
.ruff_cache/
# Environments and run directories the checks themselves create. A check that
# builds a throwaway tree in the repository must not leave anything a later
# `git add -A` would commit, and committing one makes every subsequent check
# scan it.
.venv*/
.probe-run/

# Generated agent skill directories (see skills-lock.json)
agent/
.claude/skills/
